# ---------------------------------------------------------------
# SACPL website — environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------

# Canonical site URL (used for canonical links, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.sacpl.co

# Content verification gate.
# Unset: pending (unverified) content shows in development, hidden in production.
# true: show pending content with "Pending verification" badges (use on preview/staging only).
# false: hide pending content everywhere.
NEXT_PUBLIC_SHOW_PENDING_CONTENT=

# Set to true once the Privacy Notice and Terms have been approved; makes them indexable.
LEGAL_APPROVED=

# ---------------------------------------------------------------
# Form delivery. Configure at least one provider for production.
# Without any, production form submissions return 503 instead of
# silently dropping messages; development logs them to the console.
# ---------------------------------------------------------------

# Email via Resend (https://resend.com). FORMS_FROM_EMAIL must be on a verified domain.
RESEND_API_KEY=
FORMS_FROM_EMAIL="SACPL Website <website@sacpl.co>"
ENQUIRY_TO_EMAIL=suresh.shriyan@sacpl.co,awez.waghu@sacpl.co
CAREERS_TO_EMAIL=careers@sacpl.co

# Generic webhook (e.g. Zapier, Make, n8n, a CRM). Receives JSON incl. base64 attachment.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Supabase storage of submissions (tables + bucket in docs/supabase-schema.sql).
# SERVICE ROLE KEY IS SECRET — server only, never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------
# Client portal (optional). The /login page only authenticates when ALL
# three are set and point to a real SACPL client portal.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CLIENT_PORTAL_URL=
